{
	"name": "caritas",
	"version": "0.1.0",
	"private": true,
	"description": "Reference API guide recipes for pi-lean-host. A devDep-only source repo consumed by its own test tooling; never published to npm.",
	"type": "module",
	"scripts": {
		"test": "vitest run",
		"test:ci": "vitest run --exclude='**/endpoint-coverage.test.ts'",
		"test:integration": "bash scripts/test-integration.sh",
		"lint": "biome ci",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.ts": "biome check --write"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/node": "^25.9.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"pi-lean-host": "0.4.0",
		"tsx": "^4.19.2",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	}
}
